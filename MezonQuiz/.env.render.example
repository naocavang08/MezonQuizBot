ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# Optional: paste a minified appsettings.json here to reuse the full config without baking the file into the Docker image.
# Individual variables below still override values from APPSETTINGS_JSON.
APPSETTINGS_JSON={"Logging":{"LogLevel":{"Default":"Information","Microsoft.AspNetCore":"Warning"}},"AllowedHosts":"*","Cors":{"AllowedOrigins":[]},"ConnectionStrings":{"DefaultConnection":""},"JwtTokenSettings":{"SymmetricSecurityKey":"","ValidIssuer":"WebApp","ValidAudience":"MezonQuizFE","JwtRegisteredClaimNamesSub":"MezonQuizAccessToken"},"Domain":{"BaseUrl":"https://<render-service-name>.onrender.com"},"MezonOAuth2":{"ClientId":"","ClientSecret":"","AuthorizeUrl":"https://oauth2.mezon.ai/oauth2/auth","TokenUrl":"https://oauth2.mezon.ai/oauth2/token","UserInfoUrl":"https://oauth2.mezon.ai/userinfo","RedirectUri":"https://<render-service-name>.onrender.com/oauth/mezon/callback","Scope":"openid offline"},"MezonBot":{"BotId":"","BotToken":"","BotName":"","BotAvatar":"","BaseLink":"https://mezon.ai/chat","ApiHost":"gw.mezon.ai","ApiPort":"443","UseSsl":true},"Startup":{"FailOnSeedError":false}}

ConnectionStrings__DefaultConnection=Host=<render-postgres-host>;Port=5432;Database=<database>;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true

Cors__AllowedOrigins__0=<frontend-origin>
Domain__BaseUrl=https://<render-service-name>.onrender.com

JwtTokenSettings__SymmetricSecurityKey=<strong-random-secret>
JwtTokenSettings__ValidIssuer=WebApp
JwtTokenSettings__ValidAudience=MezonQuizFE
JwtTokenSettings__JwtRegisteredClaimNamesSub=MezonQuizAccessToken

MezonOAuth2__ClientId=<client-id>
MezonOAuth2__ClientSecret=<client-secret>
MezonOAuth2__AuthorizeUrl=https://oauth2.mezon.ai/oauth2/auth
MezonOAuth2__TokenUrl=https://oauth2.mezon.ai/oauth2/token
MezonOAuth2__UserInfoUrl=https://oauth2.mezon.ai/userinfo
MezonOAuth2__RedirectUri=https://<render-service-name>.onrender.com/oauth/mezon/callback
MezonOAuth2__Scope=openid offline

MezonBot__BotId=<bot-id>
MezonBot__BotToken=<bot-token>
MezonBot__BotName=<bot-name>
MezonBot__BotAvatar=<avatar-url>
MezonBot__BaseLink=https://mezon.ai/chat
MezonBot__ApiHost=gw.mezon.ai
MezonBot__ApiPort=443
MezonBot__UseSsl=true

Startup__FailOnSeedError=false
